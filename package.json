{
  "name": "hoanxu-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "generate": "openapi-typescript contracts/openapi.yaml -o src/lib/api-schema.d.ts",
    "generate:i18n": "node scripts/generate-locales.mjs",
    "test": "node scripts/run-browser-tests.mjs e2e",
    "test:csp": "node scripts/run-browser-tests.mjs csp",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:scripts": "node --test tests/scripts/*.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lean-qr": "^2.7.4",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0"
  }
}
